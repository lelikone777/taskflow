    "email:export": "email export --dir src/emails --outDir src/emails/dist"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "1.0.8",
    "@reduxjs/toolkit": "^2.11.2",
